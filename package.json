{
  "name": "nifty-subgraph",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "codegen": "graph codegen",
    "codegen:mainnet": "graph codegen configs/subgraph.mainnet.yaml",
    "codegen:sepolia": "graph codegen configs/subgraph.sepolia.yaml",
    "build": "graph build",
    "build:mainnet": "graph build configs/subgraph.mainnet.yaml",
    "build:sepolia": "graph build configs/subgraph.sepolia.yaml",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ nifty-league-sepolia",
    "deploy:mainnet": "graph deploy --node https://api.studio.thegraph.com/deploy/ nifty-league-sepolia configs/subgraph.mainnet.yaml",
    "deploy:sepolia": "graph deploy --node https://api.studio.thegraph.com/deploy/ nifty-league-sepolia configs/subgraph.sepolia.yaml",
    "create-local": "graph create --node http://localhost:8020/ nifty-league-sepolia",
    "remove-local": "graph remove --node http://localhost:8020/ nifty-league-sepolia",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 nifty-league-sepolia",
    "test": "bun test bun-tests",
    "test:unit": "bun test bun-tests",
    "test:integration": "bun run test:graph",
    "test:coverage": "node scripts/check-coverage.mjs",
    "performance": "bun run scripts/performance-audit.ts",
    "performance:check": "bun run scripts/performance-audit.ts",
    "performance:live": "bun run scripts/performance-audit.ts --live",
    "audit": "bash scripts/audit.sh",
    "dev": "graph create --node http://localhost:8020/ nifty-league-sepolia && graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 nifty-league-sepolia",
    "start": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 nifty-league-sepolia",
    "type:check": "graph build",
    "test:graph": "sh -c \"ldconfig -p | grep -q libpq.so.5 || (sudo apt-get update -qq && sudo apt-get install -y -qq libpq5); graph test --version 0.6.0\""
  },
  "devDependencies": {
    "@assemblyscript/loader": "0.28.20",
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2",
    "assemblyscript": "0.19.23",
    "lint-staged": "17.4.1",
    "matchstick-as": "0.6.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "6.0.3",
    "wabt": "1.0.39"
  },
  "overrides": {
    "assemblyscript": "0.19.23",
    "cross-spawn": "7.0.6",
    "ejs": "3.1.10",
    "glob": "11.1.0",
    "immutable": "5.1.9",
    "js-yaml": "4.3.2",
    "semver": "7.8.5",
    "stream-json": "3.6.0",
    "undici": "7.29.0",
    "uuid": "11.1.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.4.0"
}
